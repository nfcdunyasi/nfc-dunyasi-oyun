# İşletme QR'ları ve oda davet linkleri oyun sayfasına gider
/q/:source   /oyun/?kaynak=:source   302
/oda/:code   /oyun/?oda=:code        302

# Basılı QR kodların ana adresi: oyun sonradan başka yere taşınırsa SADECE bu satırı değiştir
/oyna   /oyun/   302

# Düğün Planla: salonun kalıcı QR/NFC sayfası, davet bağlantıları, demo ve yönetim aynı sayfa uygulamasında açılır
/salon/*          /dugun/index.html   200
/d/*              /dugun/index.html   200
/dugun/demo       /dugun/index.html   200
/dugun/demo/*     /dugun/index.html   200
/dugun/giris      /dugun/index.html   200
/dugun/yonetim    /dugun/index.html   200
/dugun/yonetim/*  /dugun/index.html   200

# Randevu Vaktim: işletmenin randevu sayfası, randevu durumu, usta paneli ve yönetim aynı sayfa uygulamasında açılır
# (js/css/img dosyaları gerçek dosya olduğu için önce onlar sunulur)
/randevu/*        /randevu/index.html  200

# Sekme simgesi: tarayıcılar ve arama motorları /favicon.ico adresini kendiliğinden ister
/favicon.ico      /images/favicon.png   200

# Eski sitenin hâlâ ziyaret edilen mağaza adresleri ana sayfaya gider
/magaza           /   301
/magaza/*         /   301
/en/*             /   301
